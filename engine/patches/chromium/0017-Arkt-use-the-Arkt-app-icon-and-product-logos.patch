From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arkt contributors <noreply@arkt.invalid>
Date: Tue, 24 Nov 2026 20:27:28 +0100
Subject: [PATCH] Arkt: use the Arkt app icon and product logos

The Mac app icon (app.icns, Assets.car) comes from //arkt/branding/mac, and the product logo PNGs are replaced in place by the Arkt logos at the same pixel sizes (#74).
---
 chrome/BUILD.gn                               |   4 ++--
 .../app/theme/chromium/product_logo_128.png   | Bin 4393 -> 19067 bytes
 chrome/app/theme/chromium/product_logo_16.png | Bin 1399 -> 768 bytes
 chrome/app/theme/chromium/product_logo_24.png | Bin 759 -> 1359 bytes
 .../app/theme/chromium/product_logo_256.png   | Bin 9614 -> 61268 bytes
 chrome/app/theme/chromium/product_logo_64.png | Bin 2172 -> 6150 bytes
 .../chromium/product_logo_16.png              | Bin 662 -> 768 bytes
 .../chromium/product_logo_32.png              | Bin 822 -> 2085 bytes
 .../chromium/product_logo_16.png              | Bin 1524 -> 2085 bytes
 .../chromium/product_logo_32.png              | Bin 1402 -> 6150 bytes
 10 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index d98c86e5da..fdf81713cd 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -670,12 +670,12 @@ if (is_win) {
   }
 
   bundle_data("chrome_app_icon") {
-    sources = [ "app/theme/$branding_path_component/mac/app.icns" ]
+    sources = [ "//arkt/branding/mac/app.icns" ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
   }
 
   bundle_data("chrome_asset_catalog") {
-    sources = [ "app/theme/$branding_path_component/mac/Assets.car" ]
+    sources = [ "//arkt/branding/mac/Assets.car" ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
   }
 
diff --git a/chrome/app/theme/chromium/product_logo_128.png b/chrome/app/theme/chromium/product_logo_128.png
index 9ce48f920e87c57d0bfcd058c9371cffe3f15a5f..dcda881c9765286f6499162cbcf555bbc16c750f 100644
