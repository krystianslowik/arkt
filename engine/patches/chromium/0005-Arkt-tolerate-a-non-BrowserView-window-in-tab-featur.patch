From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arkt contributors <noreply@arkt.invalid>
Date: Fri, 23 Oct 2026 15:55:27 +0200
Subject: [PATCH] Arkt: tolerate a non-BrowserView window in tab features

SadTabController looked up the BrowserView of a crashed tab's window and
dereferenced it. A normal window that is not a BrowserView has no contents
web views, so the controller now keeps the sad tab view unparented there,
as it already does when no contents web view shows the tab.
---
 chrome/browser/ui/sad_tab_controller.cc | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/ui/sad_tab_controller.cc b/chrome/browser/ui/sad_tab_controller.cc
index 804a89c558..1837db90db 100644
--- a/chrome/browser/ui/sad_tab_controller.cc
+++ b/chrome/browser/ui/sad_tab_controller.cc
@@ -29,7 +29,11 @@ ContentsWebView* FindContentsWebView(content::WebContents* web_contents) {
     return nullptr;
   }
   BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
-  DCHECK(browser_view);
+  // A normal window that is not a BrowserView (Arkt) has no contents web
+  // views; the controller then keeps the sad tab view unparented.
+  if (!browser_view) {
+    return nullptr;
+  }
 
   for (auto* contents_view : browser_view->GetAllVisibleContentsWebViews()) {
     if (contents_view->web_contents() == web_contents) {
