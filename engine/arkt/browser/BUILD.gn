# Lets //arkt/browser create normal browser windows. Dependency-free on
# purpose: //chrome/browser/ui/views/frame:browser_window_factory depends on it
# (patch 0004), and depending on //arkt/browser there would be a GN cycle.
source_set("window_factory_hook") {
  sources = [
    "arkt_browser_window_factory_hook.cc",
    "arkt_browser_window_factory_hook.h",
  ]
  public_deps = [ "//chrome/browser/ui:browser_window_deleter" ]
}

# Lets //arkt/browser show extension dialogs on Arkt windows as native sheets.
# Kept light for the same reason: the Views extension dialog targets depend on
# it (patch 0007).
source_set("extension_dialog_hook") {
  sources = [
    "arkt_extension_dialog_hook.cc",
    "arkt_extension_dialog_hook.h",
  ]
  public_deps = [
    "//extensions/browser",
    "//ui/gfx",
  ]
}

