{
  "brand": "arkt",
  "website": "https://arkt.dev",
  "repository": "https://github.com/krystianslowik/arkt",
  "colors": {
    "mustard": "#E9B520",
    "mustardHighlight": "#F3CA3D",
    "mustardShade": "#DCA319",
    "foldShadow": "#A96E12",
    "porcelain": "#FAF9F5",
    "graphite": "#202321"
  },
  "spacing": [
    8,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "sourceArtwork": {
    "type": "raster",
    "iconNativePixels": [
      456,
      456
    ],
    "wordmarkNativePixels": [
      180,
      76
    ],
    "pureVectorLogo": false
  },
  "type": {
    "family": "Avenir Next",
    "postScriptNames": {
      "regular": "AvenirNext-Regular",
      "medium": "AvenirNext-Medium",
      "demiBold": "AvenirNext-DemiBold"
    },
    "source": "macOS system font, used by name; never bundled or redistributed",
    "fallback": "system font",
    "surfaces": "website, first run and onboarding, About, social graphics; browser chrome stays on the system font",
    "display": {
      "weight": 600,
      "lineHeight": 0.92,
      "trackingEm": -0.055
    },
    "body": {
      "weight": 400,
      "sizes": [
        18,
        20
      ],
      "lineHeight": 1.5,
      "trackingEm": 0
    },
    "eyebrow": {
      "weight": 600,
      "size": 12,
      "trackingEm": 0.16,
      "uppercase": true
    },
    "button": {
      "weight": 600,
      "size": 15,
      "height": 50
    }
  }
}
